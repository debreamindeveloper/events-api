<Project>
  <!--
    Redirect build output OUT of OneDrive on Windows dev machines to avoid
    file-lock errors (e.g. "GenerateFunctionMetadata" task failing with
    "Access to the path ... is denied" when OneDrive syncs obj\ mid-build).
    Gated to Windows only so CI (Linux runners without %LOCALAPPDATA%) keeps
    the default in-tree bin/ and obj/ paths.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and '$(LOCALAPPDATA)' != ''">
    <_BuildRoot>$(LOCALAPPDATA)\DotNetBuild\Events-API\</_BuildRoot>
    <BaseOutputPath>$(_BuildRoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(_BuildRoot)obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
